# Runtime
NODE_ENV=development
# PORT is provided automatically by many hosts (Render, etc.)
# PORT=10000
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
SERVER_ORIGIN=http://localhost:4000

# Auth / sessions
SESSION_COOKIE_NAME=lovechat_session
SESSION_TTL_SECONDS=43200
SESSION_JWT_SECRET=replace_with_long_random_secret
WS_TOKEN_TTL_SECONDS=900
WS_TOKEN_SECRET=replace_with_long_random_secret

# WebAuthn
WEBAUTHN_RP_NAME=LoveChat
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Data and media
DATA_DIR=./data
MEDIA_DIR=./media
MEDIA_RETENTION_MINUTES=120

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# App-level crypto metadata
CRYPTO_PROTOCOL_VERSION=1
