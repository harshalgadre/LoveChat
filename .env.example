# Runtime
NODE_ENV=development
# PORT is provided automatically by many hosts (Render, Railway, etc.)
# PORT=10000
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
SERVER_ORIGIN=http://localhost:4000

# Auth / sessions
SESSION_COOKIE_NAME=lovechat_session
# Use `none` for cross-site frontend/backend deployments over HTTPS (e.g. Vercel + Render)
SESSION_COOKIE_SAMESITE=strict
SESSION_TTL_SECONDS=43200
SESSION_JWT_SECRET=replace_with_long_random_secret
WS_TOKEN_TTL_SECONDS=900
WS_TOKEN_SECRET=replace_with_long_random_secret

# WebAuthn
WEBAUTHN_RP_NAME=LoveChat
# RP ID must be hostname only (no https://)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
MAX_USERS=5

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=lovechat

# Media retention
MEDIA_RETENTION_MINUTES=120

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# App-level crypto metadata
CRYPTO_PROTOCOL_VERSION=1

# Frontend (apps/web)
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
